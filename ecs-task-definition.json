{
  "containerDefinitions": [
    {
      "name": "Main",
      "image": "184974285238.dkr.ecr.ap-northeast-2.amazonaws.com/momentory-api:b741acbc8c1e93626f0460d5c8c8d8835e29733c",
      "cpu": 0,
      "portMappings": [
        {
          "containerPort": 8080,
          "hostPort": 8080,
          "protocol": "tcp",
          "name": "main-8080-tcp",
          "appProtocol": "http"
        }
      ],
      "essential": true,
      "environment": [
        {
          "name": "KAKAO_API_BASE_URL",
          "value": "https://kapi.kakao.com"
        },
        {
          "name": "GEMINI_MODEL",
          "value": "gemini-flash-lite-latest"
        },
        {
          "name": "KAKAO_READ_TIMEOUT",
          "value": "5s"
        },
        {
          "name": "SPRING_PROFILES_ACTIVE",
          "value": "prod"
        },
        {
          "name": "GRAFANA_OTLP_ENABLED",
          "value": "true"
        },
        {
          "name": "KAKAO_CONNECT_TIMEOUT",
          "value": "3s"
        },
        {
          "name": "APPLE_TEAM_ID",
          "value": "U8R7H6ASTS"
        },
        {
          "name": "APPLE_KEY_ID",
          "value": "5A9C8XNK3A"
        }
      ],
      "environmentFiles": [],
      "mountPoints": [],
      "volumesFrom": [],
      "secrets": [
        {
          "name": "GRAFANA_OTLP_URL",
          "valueFrom": "/momentory/prod/GRAFANA_OTLP_URL"
        },
        {
          "name": "GRAFANA_OTLP_AUTH",
          "valueFrom": "/momentory/prod/GRAFANA_OTLP_AUTH"
        },
        {
          "name": "DB_URL",
          "valueFrom": "/momentory/prod/DB_URL"
        },
        {
          "name": "DB_USERNAME",
          "valueFrom": "/momentory/prod/DB_USERNAME"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "/momentory/prod/DB_PASSWORD"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "/momentory/prod/JWT_SECRET"
        },
        {
          "name": "JWT_REFRESH_EXPIRATION",
          "valueFrom": "/momentory/prod/JWT_REFRESH_EXPIRATION"
        },
        {
          "name": "KAKAO_APP_ID",
          "valueFrom": "/momentory/prod/KAKAO_APP_ID"
        },
        {
          "name": "KAKAO_ADMIN_KEY",
          "valueFrom": "/momentory/prod/KAKAO_ADMIN_KEY"
        },
        {
          "name": "GEMINI_API_KEY",
          "valueFrom": "/momentory/prod/GEMINI_API_KEY"
        },
        {
          "name": "APPLE_PRIVATE_KEY",
          "valueFrom": "/momentory/prod/APPLE_PRIVATE_KEY"
        }
      ],
      "ulimits": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/momentory-core-task",
          "awslogs-create-group": "true",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        },
        "secretOptions": []
      },
      "systemControls": []
    }
  ],
  "family": "momentory-core-task",
  "executionRoleArn": "arn:aws:iam::184974285238:role/ecsTaskExecutionRole",
  "networkMode": "awsvpc",
  "volumes": [],
  "placementConstraints": [],
  "runtimePlatform": {
    "cpuArchitecture": "X86_64",
    "operatingSystemFamily": "LINUX"
  },
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "3072",
  "enableFaultInjection": false
}
