APP_IMAGE=your-registry/momentory-be:your-tag
APP_PORT=8080

POSTGRES_DB=momentory
POSTGRES_USER=momentory
POSTGRES_PASSWORD=replace-with-secure-password

DB_URL=jdbc:postgresql://postgres:5432/momentory
DB_USERNAME=momentory
DB_PASSWORD=replace-with-secure-password

JWT_SECRET=replace-with-base64-encoded-random-32-byte-or-longer-secret
JWT_REFRESH_EXPIRATION=30d

KAKAO_APP_ID=replace-with-kakao-app-id
KAKAO_ADMIN_KEY=replace-with-kakao-admin-key
KAKAO_API_BASE_URL=https://kapi.kakao.com
KAKAO_CONNECT_TIMEOUT=3s
KAKAO_READ_TIMEOUT=5s

# 애플 로그인 — identity token 의 aud 와 대조할 **iOS 앱 번들 ID**.
# 비밀이 아니다(애플이 앱을 알아보는 이름). application.yml 에 같은 기본값이 있어
# **적지 않아도 된다** — 다른 번들 ID 로 띄울 때만 설정한다.
# APPLE_CLIENT_ID=kr.momentory.app

GEMINI_API_KEY=replace-with-gemini-developer-api-key
GEMINI_MODEL=gemini-flash-lite-latest

# Optional: defaults to false in the prod profile.
SWAGGER_ENABLED=false
